# dota2-planner LLM 配置（可选）
# 不配置 DOTA_LLM_API_KEY 时，系统自动回退本地模板生成策略，完全离线可用。

# 1) OpenRouter（默认）
DOTA_LLM_API_KEY=sk-or-your-key-here
DOTA_LLM_BASE_URL=https://openrouter.ai/api/v1
DOTA_LLM_MODEL=openrouter/auto

# 2) 或任意 OpenAI 兼容网关（示例：DeepSeek / 本地 vLLM 等）
# DOTA_LLM_BASE_URL=https://api.deepseek.com/v1
# DOTA_LLM_MODEL=deepseek-chat

# 其他可选项
# DOTA_LLM_TIMEOUT=30
# DOTA_LLM_MAX_TOKENS=1000          # 单窗口/单次判定最大生成 token（默认 1000；过小会导致
#                                   # reasoning 模型只输出思考、content 为空）
# DOTA_LLM_REASONING_EFFORT=high    # 推理强度（可选值 low/medium/high，OpenAI 兼容 reasoning 模型用）

# 说明：DOTA_LLM_API_KEY 同时用于 ingest 的核心策略生成 和 diff 的好坏判定；
# 不配置则两者都回退本地规则/模板，完全离线。
# DOTA_DB=/absolute/path/to/dota_planner.db
